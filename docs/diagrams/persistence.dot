digraph Crownline {
  graph [rankdir=LR, bgcolor="white", pad=.16, label="Atomic recovery", labelloc=t];
  node [shape=box, style="rounded,filled", fillcolor="#eef3e9", color="#526e5a", fontname="Helvetica", fontsize=10];
  edge [color="#586d5f", fontname="Helvetica", fontsize=9];
  create [label="Write temporary shard"];
  sync [label="Sync bytes"];
  swap [label="Rename shard"];
  manifest [label="Replace checksum inventory"];
  verify [label="Validate inventory before resume"];
  create -> sync -> swap -> manifest -> verify;
  verify -> create [label="next slice"];
}
